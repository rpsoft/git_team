# Copy to .env and fill in.

# Agents (and the HR review writer) run on Claude Code. Use your Claude subscription:
#   run `claude setup-token` on your machine and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# ...or, alternatively, an API key (leave empty if you use the token above)
ANTHROPIC_API_KEY=

# You, the manager (dashboard login + your email address manager@MAIL_DOMAIN)
MANAGER_USERNAME=manager
MANAGER_PASSWORD=change-me
MANAGER_NAME=The Manager
SECRET_KEY=generate-a-long-random-string

MAIL_DOMAIN=team.local

# Gitea admin account (created by `make bootstrap`); also your login to Gitea
GITEA_ADMIN_USER=studio-admin
GITEA_ADMIN_PASSWORD=change-me-too
GITEA_ORG=studio
GITEA_PUBLIC_URL=http://localhost:3000
GITEA_WEBHOOK_SECRET=generate-another-random-string

# Default model for new hires and for performance reviews
DEFAULT_MODEL=claude-opus-5-5
REVIEW_MODEL=claude-opus-5-5
# Max agents working at the same time
WORKER_MAX_JOBS=4
